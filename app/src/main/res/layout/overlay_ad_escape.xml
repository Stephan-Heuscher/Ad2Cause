<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/bg_escape_container">

    <ImageButton
        android:id="@+id/escapeButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_escape_button"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/cancel_ad"
        android:scaleType="center"
        android:elevation="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cancel_ad_label"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:shadowColor="#000000"
        android:shadowRadius="2"
        android:shadowDx="1"
        android:shadowDy="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_credit_warning"
        android:textColor="#FFCDD2"
        android:textSize="8sp"
        android:gravity="center" />

</LinearLayout>
